# Cole essas variáveis na seção "Environment variables" ao criar a stack no Portainer.
# Não é necessário criar arquivo .env no servidor — o Portainer injeta isso direto nos containers.

# --- Backend ---
GROK_API_KEY=sua_chave_aqui
# model id da API Groq (chat completions) — trocável sem redeploy de código
GROK_MODEL=openai/gpt-oss-20b
GITHUB_TOKEN=seu_token_aqui
GITHUB_USERNAME=seu_usuario
JWT_SECRET=qualquer_string_secreta

# --- Bot WhatsApp ---
MY_WHATSAPP_NUMBER=5531900000000@c.us
REMINDER_CRON=0 19 * * 1-5

# --- Frontend ---
# vazio = caminho relativo (/api/...), nginx roteia pro backend internamente
NEXT_PUBLIC_API_URL=
FRONTEND_URL=https://websec.seudominio.com
